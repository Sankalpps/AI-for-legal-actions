# ── AI provider ───────────────────────────────────────────────────────────────
# gemini (default) | openai | auto.  "auto" falls back to OpenAI when Gemini fails,
# which means a failed call can be billed TWICE - keep "gemini" unless you want that.
AI_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
# Lower-cost Gemini option to preserve credits.
GEMINI_MODEL=gemini-3.5-flash-lite

# Required only when AI_PROVIDER=openai or auto
OPENAI_API_KEY=your_openai_api_key_here
# Budget-friendly OpenAI model.
OPENAI_MODEL=gpt-4o-mini

# ── Cost controls (every real AI call costs credits) ──────────────────────────
# Hard cap on real provider calls per UTC day. Cached answers don't count. 0 = unlimited.
DAILY_AI_CALL_LIMIT=300
# Per-IP requests per minute on AI/upload endpoints. 0 = disabled.
RATE_LIMIT_PER_MINUTE=20
# Global ceiling for output tokens on any single call (features set tighter caps themselves).
MAX_OUTPUT_TOKENS=2048
# Response cache: identical requests are answered for free.
CACHE_TTL=604800
CACHE_MAX_SIZE=300
# Q&A: documents longer than this many characters are reduced to the passages relevant to the question.
QNA_CONTEXT_CHARS=8000
AI_REQUEST_TIMEOUT=90
GEMINI_TRANSPORT=rest

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API (default: any).
# Example: ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000
ALLOWED_ORIGINS=*
